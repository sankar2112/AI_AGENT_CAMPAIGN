DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bfsi_campaigns
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=700
BEDROCK_TEMPERATURE=0.6
# Set to false to hard-fail when AWS credentials are missing instead of using the offline generator
ALLOW_MOCK_LLM=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AWS credentials come from the standard chain (env vars, ~/.aws/credentials, or an IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
